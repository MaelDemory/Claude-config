{
  "permissions": {
    "allow": [
      "Bash(rtk:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(cmux browser:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\"/hooks/rtk-rewrite.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude Code attend une permission ou une réponse\" with title \"Claude Code\"' ; afplay /System/Library/Sounds/Funk.aiff &"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude Code a terminé\" with title \"Claude Code\"' ; afplay /System/Library/Sounds/Glass.aiff &"
          }
        ]
      }
    ]
  }
}
